{
  "name": "@forge/public-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node scripts/static.mjs",
    "build:pages": "node scripts/pages-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "releases:refresh": "node scripts/releases.mjs",
    "test": "node --test tests/releases.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@radix-ui/react-tabs": "1.1.13",
    "lucide-react": "0.575.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
