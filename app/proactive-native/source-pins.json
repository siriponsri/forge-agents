  "findings": [
    {
      "code": "T3_OPENCODE2_SESSION_OVERRIDE",
      "meaning": "T3 installs session shell/edit/external_directory approval rules and enables the thread T3 MCP namespace, not a mandatory native tool-name allowlist."
    },
    {
      "code": "OPENCODE_TOOL_POLICY_REQUIRES_PERMISSION_CALL",
      "meaning": "tool.use policy is a permission evaluate hook; central Tool execution does not assert it for every native tool."
    },
    {
      "code": "OPENCODE_DISCOVERY_USES_PERMISSION_ALIAS",
      "meaning": "whollyDisabled filters the declared permission action or tool name; a new native tool declaring an allowed/ask alias is not universally denied by its own name."
    },
    {
      "code": "OPENCODE_AMBIENT_CONTEXT_OUTSIDE_ACTION_GATE",
      "meaning": "Native instruction discovery reads workspace/global instruction files through FSUtil outside the model tool permission guard."
    },
    {
      "code": "FORGE_MEDIATED_ROUTE_NOT_IMPLEMENTED",
      "meaning": "No qualified mandatory all-action route with authenticated bounded FORGE MCP actions and current per-effect proof has been delivered by this research worker."
    }
  ]
}
