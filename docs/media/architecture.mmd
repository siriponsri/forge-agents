flowchart LR
  Owner["Owner<br/>Decisions and approval"] --> Forge["FORGE canonical services<br/>Projects / plans / tasks / evidence"]
  Forge --> T3["T3 provider threads<br/>Single execution owner"]
  T3 --> Projection["AG-UI<br/>Observed state and events"]
  Projection --> Views["Chat + Node-Edge Workspace<br/>Two views of the same records"]
  Views --> Forge
  Forge --> Office["Univer Docs + Sheets<br/>Revisioned save and reopen"]
  Office --> Reports["Saved ReportSpec and source revisions<br/>WordCraft / PdfCraft"]
  Reports --> Artifacts["Verified artifacts<br/>Content hashes and provenance"]
  T3 --> Artifacts
  Artifacts --> Review["QA evidence<br/>Owner acceptance"]
  Forge -.-> Guard["Guarded route<br/>Product activation pending"]
  Forge -.-> Assist["Executor + Asst<br/>Roles within existing execution authority"]
