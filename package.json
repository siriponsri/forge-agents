{
  "name": "forge-agents",
  "private": true,
  "version": "1.0.0-p11.5",
  "type": "module",
  "description": "FORGE portable runtime, opt-in AO Limited adapter, and P11.5 Orca evaluation",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:legacy": "node tests/ao-limited-adapter.test.mjs",
    "build": "vite build app/web --outDir dist",
    "start": "node app/server/main.mjs",
    "dev": "vite app/web --host 127.0.0.1",
    "check": "node --check app/server/main.mjs"
  },
  "engines": {
    "node": ">=24.13"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@univerjs/preset-docs-core": "1.6.1",
    "@univerjs/preset-sheets-core": "1.6.1",
    "@univerjs/presets": "1.6.1",
    "ajv": "8.20.0",
    "lucide-react": "0.575.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "t3": "0.1.11",
    "vite": "7.3.8"
  }
}
