{
  "name": "forge-agents",
  "private": true,
  "version": "1.1.0-alpha.3",
  "type": "module",
  "description": "FORGE v3 local workbench development: T3, AG-UI, office and reports",
  "scripts": {
    "test": "node --test tests/*.test.mjs app/web/tests/boundaries.test.mjs",
    "test:legacy": "node tests/ao-limited-adapter.test.mjs",
    "build": "vite build app/web --outDir dist",
    "start": "node app/server/main.mjs",
    "dev": "vite app/web --host 127.0.0.1",
    "check": "node --check app/server/main.mjs",
    "test:browser": "node app/web/tests/smoke.mjs"
  },
  "engines": {
    "node": ">=24.13"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.5",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@univerjs/preset-docs-core": "1.6.1",
    "@univerjs/preset-sheets-core": "1.6.1",
    "@univerjs/presets": "1.6.1",
    "lucide-react": "0.575.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "t3": "0.1.11",
    "vite": "7.3.8"
  },
  "devDependencies": {
    "playwright": "1.65.1"
  }
}
